# SnapSumbong API environment variables
#
# Local development: copy this file to .env and fill in the values.
# Production (EC2):  do NOT create .env by hand — every value below lives in
#                    AWS Systems Manager Parameter Store under
#                    /prod/backend/<NAME> and ./fetch-env.sh writes .env
#                    from it automatically. See DEPLOYMENT.md.

# --- Django core (required) ------------------------------------------------
DJANGO_SECRET_KEY=<provided_by_yourself>
JWT_SECRET_KEY=<provided_by_yourself>

# --- Database --------------------------------------------------------------
# CONNECTION STRING FORMAT: postgresql://[user]:[password]@[host]:[port]/[database_name]
# In docker compose, DB_HOST is the compose service name: db
DB_NAME=<provided_by_yourself>
DB_USER=<provided_by_yourself>
DB_PASSWORD=<provided_by_yourself>
DB_HOST=db
DB_PORT=5432
DB_CONNECTION_MAX_AGE_SECONDS=600

# --- External services (SaaS — no infrastructure to run) -------------------
CLOUDINARY_CLOUD_NAME=<provided_by_service>
CLOUDINARY_API_KEY=<provided_by_service>
CLOUDINARY_API_SECRET=<provided_by_service>

RESEND_API_KEY=<provided_by_service>
DEFAULT_FROM_EMAIL=<noreply@yourdomain.com>

# AUTH = reputation-sensitive mail (OTP/verification, password reset).
# GENERAL = in-app mail to verified users (submissions, status updates, etc.)
EMAIL_FROM_AUTH="SnapSumbong <no-reply@auth.snapsumbong.site>"
EMAIL_FROM_GENERAL="SnapSumbong <no-reply@mail.snapsumbong.site>"

# --- Environment / security ------------------------------------------------
# Exactly "True" or "False" (case-sensitive). Production: False.
DEBUG=False
# Production: True — redirects HTTP to HTTPS. Safe behind Caddy because
# SECURE_PROXY_SSL_HEADER is configured in config/settings/security.py.
SECURE_SSL_REDIRECT=True

# Domain Name Host of where this API is deployed (comma-separated if applicable, no scheme)
ALLOWED_HOSTS=
# Full Origin of the frontend (comma-separated if applicable), e.g. https://app.example.com
TRUSTED_ORIGINS=
COOKIE_DOMAIN=.localhost.test

# --- Deployment only (docker compose + Caddy — not read by Django) ---------
# Domain Caddy will serve; must also appear in ALLOWED_HOSTS
DOMAIN=api.example.com
# Email for Let's Encrypt expiry notices
CERT_EMAIL=admin@example.com
